# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
*.db
*.db-journal

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Claude Code local settings
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Playwright MCP debug artifacts
.playwright-mcp/

# Dev logs
.next-dev.err.log
.next-dev.log

# Local screenshots from dev runs
accessready-*.png

# Runtime-generated audit output (screenshots, previews, image uploads)
public/audit-screenshots/
public/audit-previews/
public/image-uploads/

# Audio / discussion transcripts
audio discussion transcript *.txt

# Graphify knowledge graph output
/graphify-out/

# Temporary Turso SQLite files
*.turso.db
*.turso.db-journal
