# ── Database ──────────────────────────────────────────────────────
# Local development (SQLite file):
DATABASE_URL=file:./accessready-dev.db

# Production (Turso — libsql cloud database, free tier):
# Sign up at https://turso.tech, create a database, and copy the URL + token.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# ── NVIDIA AI vision analysis (optional) ──────────────────────────
# Get an API key at https://build.nvidia.com
NVIDIA_API_KEY=your-nvidia-api-key-here

# ── Browser (production) ─────────────────────────────────────────
# Browserless.io — remote headless Chrome for Vercel/serverless.
# Free tier: 1,000 sessions/month. Sign up at https://browserless.io
# BROWSERLESS_WS_ENDPOINT=wss://chrome.browserless.io?token=your-api-key

# ── ngrok (optional, dev only) ────────────────────────────────────
# When exposing the local dev server through ngrok:
# NGORK_URL=your-app.ngrok-free.app
#
# Start ngrok with:
#   ngrok http 3000 --host-header=rewrite --request-header-add="ngrok-skip-browser-warning:true"
